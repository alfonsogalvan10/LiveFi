# Normalize line endings. This matters because the stack runs on Linux
# containers from a macOS host — CRLF in a shell script or SQL file that
# gets mounted into a container will fail in confusing ways.

* text=auto eol=lf

# Explicit, so these never drift regardless of core.autocrlf
*.sh    text eol=lf
*.sql   text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.xml   text eol=lf
Dockerfile text eol=lf
Makefile   text eol=lf

# Windows-only scripts (none currently — placeholder for the future)
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary — must never be line-ending converted
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.pdf   binary
