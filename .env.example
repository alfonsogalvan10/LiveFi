# ============================================================
# LiveFi — local environment template
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ============================================================

# ---------- General ----------
COMPOSE_PROJECT_NAME=livefi
ENV=local
LOG_LEVEL=INFO

# ---------- Resource tuning (important on machines with <= 8 GB RAM) ----------
# The stack contains four JVM services (Kafka, Debezium, Flink x2, Keycloak).
# Their default heap sizes are sized for servers and will exhaust an 8 GB host.
# Lower these if containers get OOM-killed; raise them on a larger machine.
KAFKA_HEAP_OPTS=-Xmx512m -Xms256m
CONNECT_HEAP_OPTS=-Xmx512m -Xms256m
KEYCLOAK_JAVA_OPTS=-Xms64m -Xmx512m
FLINK_JOBMANAGER_MEMORY=1024m
FLINK_TASKMANAGER_MEMORY=1728m

# ---------- PostgreSQL (OLTP system of record) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=livefi
POSTGRES_USER=livefi
POSTGRES_PASSWORD=change-me-postgres
# Must be `logical` for Debezium CDC
POSTGRES_WAL_LEVEL=logical

# ---------- Debezium / Kafka Connect ----------
CONNECT_BOOTSTRAP_SERVERS=kafka:9092
CONNECT_GROUP_ID=livefi-connect
CONNECT_CONFIG_STORAGE_TOPIC=_connect-configs
CONNECT_OFFSET_STORAGE_TOPIC=_connect-offsets
CONNECT_STATUS_STORAGE_TOPIC=_connect-status
CONNECT_KEY_CONVERTER=org.apache.kafka.connect.json.JsonConverter
CONNECT_VALUE_CONVERTER=org.apache.kafka.connect.json.JsonConverter
# PostgreSQL logical replication slot Debezium will create
DEBEZIUM_SLOT_NAME=livefi_slot
DEBEZIUM_PUBLICATION_NAME=livefi_publication

# ---------- Kafka ----------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_HOST_BOOTSTRAP=localhost:9092
# Fixed KRaft cluster ID — keeps a persisted volume consistent across restarts
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
TOPIC_TRADES_CDC=dbserver.public.trades
TOPIC_MARKET_PRICES=market.prices.live
TOPIC_ANALYTICS_OHLC=analytics.ohlc
TOPIC_ANALYTICS_RISK=analytics.risk
KAFKA_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

# ---------- ClickHouse (OLAP sink) ----------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=livefi
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-clickhouse

# ---------- Redis (cache / pub-sub) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=5

# ---------- Keycloak (IAM) ----------
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_REALM=livefi
KEYCLOAK_CLIENT_ID=livefi-web
KEYCLOAK_CLIENT_SECRET=change-me-keycloak-client
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Issuer as seen by Kong/token validators
KEYCLOAK_ISSUER=http://keycloak:8080/realms/livefi
# Issuer as seen by the browser
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8081/realms/livefi

# ---------- Kong (API Gateway) ----------
KONG_ADMIN_PORT=8001
KONG_PROXY_PORT=8000
KONG_MANAGER_PORT=8002
KONG_PG_DATABASE=kong
KONG_PG_USER=kong
KONG_PG_PASSWORD=change-me-kong
KONG_RATE_LIMIT_PER_MINUTE=600

# ---------- FastAPI services ----------
INGESTION_SERVICE_PORT=8080
QUERY_SERVICE_PORT=8001
JWT_ALGORITHM=RS256

# ---------- Flink ----------
FLINK_JOBMANAGER_PORT=8084
FLINK_PARALLELISM=2
FLINK_CHECKPOINT_INTERVAL_MS=10000
FLINK_STATE_BACKEND=filesystem
FLINK_CHECKPOINTS_DIR=file:///opt/flink/checkpoints

# ---------- Observability ----------
OTEL_SERVICE_NAME=livefi
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
PROMETHEUS_PORT=9090
JAEGER_UI_PORT=16686
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- Frontend ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream
